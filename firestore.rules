rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    match /terms/{termId} {
      allow read: if true;
      allow write: if false;
    }

    match /metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Kayıt: yalnızca bu 6 alan, ücretsiz başlangıç
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'subscriptionStatus', 'isPro', 'createdAt'])
        && request.resource.data.isPro == false
        && request.resource.data.subscriptionStatus == 'free';
      // Güncelleme: yalnızca dil tercihi ve seri
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['preferences', 'streak']);
      allow delete: if false;
    }

    match /user_progress/{progressId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && progressId.matches(request.auth.uid + '_.*');
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /user_morpheme_progress/{progressId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && progressId.matches(request.auth.uid + '_.*');
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
